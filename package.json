{
  "name": "atm2-carrer-mode",
  "version": "1.0.0",
  "main": "./main.js",
  "scripts": {
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -w"
  },
  "build": {
    "appId": "com.fnavarro.atm2-carrer-mode",
    "asar": true,
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": "NSIS",
      "icon": "build/icon.ico"
    }
  },
  "author": "Franco Navarro",
  "license": "MIT",
  "description": "Automobilista 2 Career Mode",
  "type": "commonjs",
  "devDependencies": {
    "electron-builder": "^26.8.1",
    "electron": "^37.2.4"
  },
  "dependencies": {
    "electron-settings": "^4.0.4",
    "electron-store": "^10.1.0"
  }
}