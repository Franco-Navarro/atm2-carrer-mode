  "description": "",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^37.2.4"
  },
  "dependencies": {
    "electron-builder": "^26.8.1",
    "electron-settings": "^4.0.4",
    "electron-store": "^10.1.0"
  }
}